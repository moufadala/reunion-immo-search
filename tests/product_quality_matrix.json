{
  "schema_version": 1,
  "project": "Immo Réunion",
  "description": "Matrice QA produit unifiée: gates existants classés par famille et criticité P0/P1/P2.",
  "levels": {
    "P0": "Bloque publication",
    "P1": "Bloque release",
    "P2": "Rapport / surveillance"
  },
  "families": {
    "search_oracle": "Recherche naturelle, oracle d'acceptation et contrats de parsing.",
    "semantic_truth": "Vérité métier des annonces, descriptions et données affichables.",
    "source_pipeline": "Santé sources et contrats pipeline non destructifs.",
    "display_public": "Affichage public, mobile, changements et parité visible.",
    "geo_photo_quality": "Qualité géolocalisation, prudence détail et photos.",
    "dedup_ops_alerts": "Opportunités, déduplication, alertes sauvegardées et cockpit ops."
  },
  "gates": [
    {
      "id": "search_oracle_v2",
      "family": "search_oracle",
      "level": "P0",
      "role": "Oracle large de recherche publique: requêtes naturelles, chips, budget et non-régression UX.",
      "scope": "URL publique via IMMO_PUBLIC_BASE; cas acceptance_search_oracle_v2.json.",
      "prerequisites": [
        "Serveur public accessible",
        "Playwright installé"
      ],
      "command": [
        "{playwright_python}",
        "tests/audit_search_oracle_v2.py"
      ],
      "timeout_seconds": 420
    },
    {
      "id": "user_search_cases",
      "family": "search_oracle",
      "level": "P0",
      "role": "Cas de recherche utilisateur signalés: quartiers, accents, budgets, meublé/non meublé.",
      "scope": "URL publique via IMMO_PUBLIC_URL.",
      "prerequisites": [
        "Serveur public accessible",
        "Playwright installé"
      ],
      "command": [
        "{playwright_python}",
        "tests/audit_user_search_cases.py"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "natural_search_contract",
      "family": "search_oracle",
      "level": "P1",
      "role": "Contrat statique de parsing/recherche naturelle embarqué dans l'app.",
      "scope": "Artefact app local.",
      "prerequisites": [
        "{app}/index.html et données associées"
      ],
      "command": [
        "python3",
        "tests/audit_natural_search_contract.py",
        "{app}"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "reunion_geo_search_contract",
      "family": "search_oracle",
      "level": "P1",
      "phase": "parallel",
      "role": "Contrat partagé géo/recherche Réunion: aliases communes, lieux métier sensibles, variantes utilisateur et oracle generator.",
      "scope": "Code local + génération oracle/inventory en répertoire temporaire; pas de publication.",
      "prerequisites": [
        "src/reunion_geo_search_contract.py",
        "scripts/generate_domain_inventory_and_oracle_v2.py",
        "{app}/listings.json",
        "{app}/changes.json"
      ],
      "command": [
        "python3",
        "tests/audit_reunion_geo_search_contract.py"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "data_truth_public",
      "family": "semantic_truth",
      "level": "P0",
      "role": "Vérifie que les données publiques visibles sont justifiées par listings.json.",
      "scope": "URL publique via IMMO_PUBLIC_BASE.",
      "prerequisites": [
        "Serveur public accessible",
        "Playwright installé"
